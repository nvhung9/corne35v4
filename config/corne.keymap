#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "QWERTY";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &mt TAB Q    &kp W  &kp E     &kp R  &kp T                 &kp Y        &kp U  &kp I               &kp O                    &kp P            &kp BSPC
&kp LCTRL  &kp A        &kp S  &kp D     &kp F  &kp G                 &kp H        &kp J  &kp K               &kp L                    &kp KP_ENTER     &kp SQT
&kp LSHFT  &mt LCTRL Z  &kp X  &kp C     &kp V  &kp B                 &kp N        &kp M  &kp LEFT_ARROW      &mt DOWN_ARROW UP_ARROW  &kp RIGHT_ARROW  &kp ESC
                               &kp LGUI  &mo 1  &mt LEFT_ALT SPACE    &lt 3 SPACE  &mo 2  &mt LEFT_SHIFT INS
            >;
        };

        number {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &mt ESC NUMBER_1  &kp N2          &kp N3          &kp N4          &kp N5             &kp N6            &kp N7     &kp N8     &kp N9      &kp N0     &none
&none  &kp LEFT_SHIFT    &msc SCRL_DOWN  &msc SCRL_UP    &mmv MOVE_UP    &mkp LCLK          &mkp LCLK         &mkp RCLK  &kp FSLH   &kp MINUS   &kp EQUAL  &none
&none  &mo 3             &bootloader     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &kp SEMICOLON     &kp SQT    &kp COMMA  &kp PERIOD  &kp CAPS   &none
                                         &kp LGUI        &trans          &sys_reset         &kp LEFT_BRACKET  &mo 3      &kp RBKT
            >;
        };

        function {
            display-name = "FUNCTION";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &sys_reset   &bootloader    &kp C_PAUSE          &kp PRINTSCREEN    &kp BSPC         &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &kp C_MENU   &kp BACKSLASH  &kp SEMICOLON        &kp SQT            &kp DELETE       &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &kp PAGE_UP  &kp PAGE_DOWN  &kp C_AL_CALCULATOR  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none
                        &trans   &mo 3    &trans    &kp HOME     &trans         &kp END
            >;
        };

        option {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans             &trans            &tog 4           &none
&none  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans             &kp C_PREVIOUS    &kp C_NEXT       &none
&none  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans  &trans  &kp C_VOLUME_DOWN  &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &none
                                   &trans        &trans        &trans          &trans  &trans  &trans
            >;

            label = "OPTION";
        };

        LOCK {
            bindings = <
&none   &none   &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
&tog 4  &tog 4  &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
&none   &none   &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
                       &none  &trans  &none    &none  &trans  &none
            >;

            label = "LOCK";
        };
    };
};
